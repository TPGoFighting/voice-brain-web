# 服务端口：Linux 默认 8120，macOS / Windows 默认 3000
PORT=8120

# 阿里云百炼 DashScope：fun-asr-realtime 实时识别 + qwen-flash 句级快修
DASHSCOPE_API_KEY=

# DeepSeek：纪要生成 / 人设重构 / 记忆抽取 / 第二大脑问答
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# 可选：默认 LLM 服务商与 Base URL。
# 运行时也可在页面「模型设置」中填写自定义 API Key / Base URL 并选择模型。
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com

# API 鉴权令牌（可选）：设置后所有 /api/* 请求必须携带
# `Authorization: Bearer <API_AUTH_TOKEN>`；留空则本地开放访问
API_AUTH_TOKEN=

# Obsidian Vault 与 Hermes Agent 反向追记（可选）
VAULT_PATH=
OBSIDIAN_AGENT_URL=http://127.0.0.1:8000
ADMIN_API_KEY=
